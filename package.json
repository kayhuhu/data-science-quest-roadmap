{
  "name": "data-science-quest-roadmap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "labs:generate": "python scripts/generate-lab-assets.py",
    "content:audit": "node scripts/generate-roadmap.mjs && node scripts/generate-assessment-datasets.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "npm run content:audit && npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern outputs --ignore-pattern .vinext",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
